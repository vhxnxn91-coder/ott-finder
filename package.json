:root {
  --bg: #161211;
  --card: #211C1A;
  --marquee: #E7B23A;
  --crimson: #C2483B;
  --mint: #4E9E86;
  --text-light: #F3EDE3;
  --text-muted: #9C948A;
  --hairline: #332C28;
}

* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text-light);
  font-family: 'Noto Sans KR', sans-serif;
}
a { color: inherit; }
button { font-family: inherit; }

.sprockets {
  display: flex;
  justify-content: space-between;
  padding: 0 16px;
  background: #0E0B0A;
  height: 14px;
}
.sprockets span {
  width: 6px;
  height: 6px;
  border-radius: 6px;
  background: var(--bg);
  margin-top: 4px;
  display: block;
}

.header { padding: 20px 20px 16px; border-bottom: 1px solid var(--hairline); }
.eyebrow { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--marquee); }
.title { font-family: 'Black Han Sans', sans-serif; font-size: 26px; margin: 4px 0 0; font-weight: 400; }

.search-input {
  width: 100%;
  margin-top: 16px;
  padding: 10px 12px;
  border-radius: 10px;
  background: var(--card);
  border: 1px solid var(--hairline);
  color: var(--text-light);
  font-size: 14px;
}
.search-input::placeholder { color: var(--text-muted); }

.filters { margin-top: 12px; }
.filters.disabled { opacity: 0.4; pointer-events: none; }

.provider-row { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; }
.provider-chip, .provider-all {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 40px;
  overflow: hidden;
  border: 1px solid var(--hairline);
  padding: 0;
  background: var(--card);
  cursor: pointer;
}
.provider-all { display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--text-light); }
.provider-chip.active, .provider-all.active { border: 2px solid var(--marquee); }
.provider-chip img { width: 100%; height: 100%; object-fit: cover; display: block; }

.filter-row { display: flex; align-items: center; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
.genre-select {
  font-size: 12px;
  padding: 8px 12px;
  border-radius: 10px;
  background: var(--card);
  border: 1px solid var(--hairline);
  color: var(--text-light);
}
.checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-light); }

.hint { font-size: 12px; color: var(--text-muted); margin-top: 8px; }

.content { padding: 16px 20px 0; }

.error-banner { border-radius: 12px; padding: 16px; margin-bottom: 16px; background: var(--card); border: 1px solid var(--crimson); }
.retry-btn {
  margin-top: 12px;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  background: var(--marquee);
  color: #241A05;
  border: none;
  cursor: pointer;
}

.empty-state { text-align: center; padding: 64px 0; font-size: 14px; color: var(--text-muted); }

.movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
.movie-card {
  text-align: left;
  border-radius: 12px;
  overflow: hidden;
  background: var(--card);
  border: 1px solid var(--hairline);
  padding: 0;
  cursor: pointer;
  color: inherit;
}
.poster-wrap { position: relative; aspect-ratio: 2 / 3; background: #0E0B0A; }
.poster-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.poster-empty { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 12px; color: var(--text-muted); }
.rating-badge {
  position: absolute; top: 6px; right: 6px;
  background: var(--marquee); color: #241A05;
  font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 6px;
  font-family: 'JetBrains Mono', monospace;
}
.movie-info { padding: 8px; }
.movie-title { font-size: 14px; color: var(--text-light); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.movie-year { font-size: 12px; color: var(--text-muted); margin-top: 2px; font-family: 'JetBrains Mono', monospace; }

.spinner-wrap { display: flex; align-items: center; justify-content: center; padding: 64px 0; }
.spinner {
  width: 28px; height: 28px; border-radius: 28px;
  border: 3px solid var(--hairline); border-top-color: var(--marquee);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.load-more-wrap { display: flex; justify-content: center; margin-top: 24px; }
.load-more-btn {
  padding: 10px 20px; border-radius: 999px; font-size: 14px; font-weight: 600;
  border: 1px solid var(--marquee); color: var(--marquee); background: transparent; cursor: pointer;
}

.footer { text-align: center; font-size: 12px; color: var(--text-muted); margin-top: 40px; padding: 0 20px 32px; }
.footer button { color: var(--text-muted); text-decoration: underline; background: none; border: none; cursor: pointer; font-size: 12px; margin-left: 8px; }

.modal-overlay {
  position: fixed; inset: 0; z-index: 50;
  display: flex; align-items: flex-end; justify-content: center;
  background: rgba(0,0,0,0.6); overflow-y: auto;
}
.modal-content {
  width: 100%; max-width: 560px; border-radius: 20px 20px 0 0;
  background: var(--card); max-height: 92vh; overflow-y: auto;
}
@media (min-width: 640px) {
  .modal-overlay { align-items: center; }
  .modal-content { border-radius: 20px; margin: 32px 0; }
}

.modal-header { display: flex; gap: 16px; padding: 20px; }
.modal-poster { width: 100px; flex-shrink: 0; border-radius: 10px; overflow: hidden; background: var(--bg); }
.modal-poster img { width: 100%; display: block; }
.modal-title { font-family: 'Black Han Sans', sans-serif; font-size: 20px; color: var(--text-light); line-height: 1.3; font-weight: 400; }
.modal-meta { font-size: 12px; color: var(--text-muted); margin-top: 4px; font-family: 'JetBrains Mono', monospace; }
.modal-rating { font-size: 12px; color: var(--marquee); margin-top: 4px; font-family: 'JetBrains Mono', monospace; }
.modal-close { flex-shrink: 0; color: var(--text-muted); font-size: 20px; background: none; border: none; cursor: pointer; align-self: flex-start; }
.modal-overview { font-size: 14px; color: var(--text-light); line-height: 1.6; padding: 0 20px; }
.modal-section { padding: 0 20px 20px; margin-top: 16px; }
.modal-section-title { font-size: 14px; font-weight: 600; color: var(--text-light); margin-bottom: 4px; }
.provider-group { margin-top: 12px; }
.provider-group-label { font-size: 12px; font-weight: 600; margin-bottom: 8px; }
.provider-list { display: flex; flex-wrap: wrap; gap: 8px; }
.provider-item {
  display: flex; align-items: center; gap: 8px; border-radius: 999px; padding: 4px 12px 4px 4px;
  background: var(--bg); border: 1px solid var(--hairline);
}
.provider-item img { width: 26px; height: 26px; border-radius: 26px; display: block; }
.provider-item-name { font-size: 12px; color: var(--text-light); }
.modal-note { font-size: 12px; color: var(--text-muted); margin-top: 12px; }
.modal-link { font-size: 12px; color: var(--marquee); text-decoration: underline; margin-top: 8px; display: inline-block; }
